{
	"compilerOptions": {
		"module": "commonjs",
		"esModuleInterop": true,
		"target": "es2022",
		"noImplicitAny": true,
		"incremental": false,
		"ignoreDeprecations": "6.0",
		"sourceMap": false,
		"rootDir": ".",
		"strict": true,
		"noEmit": false,
		"resolveJsonModule": true,
		"noUnusedLocals": true,
		"outDir": "./dist",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"typeRoots": [
			"./node_modules/@types",
			"./src/types"
		]
	},
	"include": [
		"src/**/**.ts"
	],
	"exclude": [
		"node_modules",
		"./dist",
		"./config",
		"./seeders",
		"./models",
		"./tests"
	]
}